# Reference clone of MopedMap (for architecture pattern)
MopedMap/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local build output
*.html.tmp

# SDD scratch (task briefs, review packages, reports)
.superpowers/

# Generated page
index.html

# Ручная копия сгенерированного index.html: использовалась как эталон рендера,
# но тесты рендера давно берут tempfile.mkdtemp(), а grep по репозиторию не
# находит ни одной ссылки. Правило точным именем, а не *.html — иначе под него
# попадёт radar.html, который как раз ЗАКОММИЧЕН и проверяется на lockstep.
_test_index.html

# Station snapshot: local diagnostic only, no page reads it.
# Narrow on purpose — sensors_history.json must stay committable.
sensors.json

# Generated per-city data
data/

# Meteoblue hourly cache (shared between builds via actions/cache)
mb_cache.json
